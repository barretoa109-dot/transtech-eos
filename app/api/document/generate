// app/api/document/generate/route.ts

import ExcelJS from "exceljs";
import { NextResponse } from "next/server";

export async function POST(req: Request) {
  try {
    const body = await req.json();

    const tipo = body.tipo || "excel";
    const rubro = body.rubro || "negocio";
    const nombre = body.nombre || "usuario";

    if (tipo !== "excel") {
      return NextResponse.json({
        ok: false,
        error: "Por ahora este generador real solo soporta Excel.",
      });
    }

    const workbook = new ExcelJS.Workbook();

    const ventas = workbook.addWorksheet("Ventas diarias");
    ventas.addRow(["Fecha", "Producto", "Cantidad", "Precio unitario", "Total"]);
    ventas.addRow(["2026-07-07", "Producto ejemplo", 1, 10000]);
    ventas.getCell("E2").value = { formula: "C2*D2" };

    const inventario = workbook.addWorksheet("Inventario");
    inventario.addRow(["Producto", "Stock inicial", "Entradas", "Salidas", "Stock final"]);
    inventario.addRow(["Producto ejemplo", 10, 5, 2]);
    inventario.getCell("E2").value = { formula: "B2+C2-D2" };

    const costos = workbook.addWorksheet("Costos");
    costos.addRow(["Ingrediente / Insumo", "Cantidad usada", "Costo unitario", "Costo total"]);
    costos.addRow(["Insumo ejemplo", 3, 5000]);
    costos.getCell("D2").value = { formula: "B2*C2" };

    const resumen = workbook.addWorksheet("Resumen mensual");
    resumen.addRow(["Indicador", "Valor"]);
    resumen.addRow(["Total ventas"]);
    resumen.getCell("B2").value = { formula: "'Ventas diarias'!E2" };
    resumen.addRow(["Total costos"]);
    resumen.getCell("B3").value = { formula: "Costos!D2" };
    resumen.addRow(["Margen bruto"]);
    resumen.getCell("B4").value = { formula: "B2-B3" };

    const buffer = Buffer.from(await workbook.xlsx.writeBuffer());
    const base64 = buffer.toString("base64");

    return NextResponse.json({
      ok: true,
      tipo: "excel",
      filename: `control_${rubro}_${nombre}.xlsx`,
      mimeType:
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      base64,
      mensaje: "Archivo Excel generado correctamente.",
    });
  } catch {
    return NextResponse.json(
      {
        ok: false,
        error: "No se pudo generar el documento.",
      },
      { status: 500 },
    );
  }
}
